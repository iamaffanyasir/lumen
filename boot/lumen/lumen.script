# Lumen boot animation: your logo fades in, gently pulses, with a wave of purple dots below.
Window.SetBackgroundTopColor(0.02, 0.02, 0.06);
Window.SetBackgroundBottomColor(0.08, 0.03, 0.16);
W = Window.GetWidth();
H = Window.GetHeight();

src = Image("logo.png");
lw = W * 0.38;
logo = src.Scale(lw, lw * src.GetHeight() / src.GetWidth());
cx = W / 2 - logo.GetWidth() / 2;
cy = H / 2 - logo.GetHeight() / 2;
s = Sprite(logo); s.SetPosition(cx, cy, 2); s.SetOpacity(0);

dot = Image.Text("●", 0.61, 0.42, 1, 1, "Sans 16");
for (i = 0; i < 5; i++) {
  d[i] = Sprite(dot);
  d[i].SetPosition(W / 2 - 2.5 * 28 + i * 28, cy + logo.GetHeight() + 60, 3);
  d[i].SetOpacity(0);
}

t = 0;
fun refresh() {
  t++;
  fade = Math.Min(t / 70, 1);
  s.SetOpacity(fade * (0.82 + 0.18 * Math.Sin(t / 25)));
  for (i = 0; i < 5; i++) d[i].SetOpacity(fade * (0.15 + 0.85 * Math.Max(0, Math.Sin(t / 9 - i * 0.8))));
}
Plymouth.SetRefreshFunction(refresh);
